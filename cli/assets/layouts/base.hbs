<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{info.summary}}" />
    <meta property="og:title" content="{{title}} | {{info.name}}" />
    <meta property="og:description" content="{{info.summary}}" />
    <meta property="og:type" content="website" />
    <title>{{> title}}</title>
    <base href="{{root}}" />

    <!-- Your existing stylesheets -->
    <link rel="stylesheet" href="main.css" />
    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="custom.css" />

    <style>
        @view-transition {
            navigation: auto;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }
    </style>
</head>

<body>
    <a href="#content" class="skip-link">Skip to content</a>
    <main id="content">
        {{> @partial-block }}
    </main>
    <footer>
        <div class="row gap-xs justify-center p-xs wrap">
            {{#if info.imprint}}
            <a href="{{info.imprint}}" target="_blank" rel="noopener noreferrer" class="btn">Imprint</a>
            {{/if}}
            {{#if info.privacy}}
            <a href="{{info.privacy}}" target="_blank" rel="noopener noreferrer" class="btn">Privacy Policy</a>
            {{/if}}
        </div>
        <div class="row gap-xs justify-center p-xs wrap">
            {{#each info.links}}
            <a href="{{this}}" target="_blank" rel="noopener noreferrer" class="btn">{{@key}}</a>
            {{/each}}
        </div>
    </footer>

    <script>
        (function () {
            const baseHref = document.querySelector('base')?.href || document.baseURI;
            const contentEl = document.getElementById('content');

            // Helper: load URL via fetch and extract #content HTML
            async function fetchContent(url) {
                const res = await fetch(url, { headers: { 'X-Requested-With': 'fetch' } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const text = await res.text();
                // parse and grab the new #content
                const parser = new DOMParser();
                const doc = parser.parseFromString(text, 'text/html');
                return {
                    html: doc.getElementById('content').innerHTML,
                    title: doc.title,
                };
            }

            // Handle navigation: fetch + swap + history
            async function navigateTo(url) {
                // Use View Transition API if available
                const useVT = typeof document.startViewTransition === 'function';

                const performSwap = async () => {
                    try {
                        const { html, title } = await fetchContent(url);
                        contentEl.innerHTML = html;
                        document.title = title;
                    } catch (err) {
                        console.error('Navigation error:', err);
                        location.href = url; // fallback to full reload
                    }
                };

                if (useVT) {
                    document.startViewTransition(performSwap);
                } else {
                    await performSwap();
                }
            }

            // Intercept all same-origin link clicks
            document.body.addEventListener('click', e => {
                const a = e.target.closest('a[href]');
                if (!a) return;
                const rawHref = a.getAttribute('href');
                // ignore external links, anchors, or scripts
                if (rawHref.startsWith('#') || a.target === '_blank') return;
                const url = new URL(rawHref, baseHref);
                console.log('Navigating to:', url.href, 'from:', location.href);
                if (url.origin !== location.origin) return;

                e.preventDefault();
                history.pushState(null, '', url.href);
                navigateTo(url.href);
            });

            // Handle back/forward buttons
            window.addEventListener('popstate', () => {
                navigateTo(location.href);
            });
        })();
    </script>
</body>

</html>