{{#> layouts/main.hbs active_page="" title=author.name}}
<div class="container">
    <div class="row wrap justify-center align-start gap-lg mv-xl">
        <section class="card paper col align-center gap-sm max-w-md flex" aria-label="Author profile">
            {{#if author.avatar_url}}
            <img class="author-avatar" src="{{author.avatar_url}}" alt="{{display author}}">
            {{/if}}
            <h1 class="m-none text-center">{{display author}}</h1>
            <p class="m-none">@{{author.name}}</p>
            <p class="text bold m-none">{{len assets}} {{#if (eq (len assets) 1)}}asset{{else}}assets{{/if}}</p>
            {{#if author.description}}<p class="text m-none">{{author.description}}</p>{{/if}}
            <div class="row wrap justify-center gap-xs mt-sm">
                {{#if author.email}}
                <a class="btn secondary" href="mailto:{{author.email}}">Email author</a>
                {{/if}}
                {{#each author.links}}
                <a class="btn secondary" href="{{this}}" target="_blank" rel="noopener noreferrer">Visit link</a>
                {{/each}}
            </div>
        </section>
        <section class="col gap-md flex min-w-md" aria-label="Author assets">
            <h2>Published assets</h2>
            <ul class="col gap-sm p-none">
                {{#each assets}}
                {{> components/item.hbs href=(concat this.author "/" this.name "/") title=this.name description=this.summary}}
                {{else}}
                <li class="card paper">No assets found.</li>
                {{/each}}
            </ul>
        </section>
    </div>
</div>
{{/layouts/main.hbs}}
