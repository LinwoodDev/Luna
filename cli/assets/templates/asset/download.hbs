{{#> layouts/asset.hbs activeTab="download"}}
<section class="card paper">
  <h1>{{version.name}}</h1>
  <p>SHA-256 checksum: <code>{{version.sha256}}</code></p>
  <button id="downloadBtn" class="btn secondary" data-url="{{version.download_url}}"
    data-sha="{{version.sha256}}">Retry</button>
  <div id="progressContainer" style="display:none; margin-top:1rem;">
    <p id="status">Preparing download...</p>
    <progress id="progress" value="0" max="100" style="width:100%;"></progress>
  </div>
  <noscript>
    <p>Please enable JavaScript to download the asset.</p>
    <p>Alternatively, you can download it directly from <a href="{{version.download_url}}">this link</a>.</p>
    <p>Make sure to verify the SHA-256 checksum <code>{{version.sha256}}</code> after downloading.</p>
  </noscript>
  <div>{{{md version.changes}}}</div>
</section>

<script src="download.js"></script>
{{/layouts/asset.hbs}}