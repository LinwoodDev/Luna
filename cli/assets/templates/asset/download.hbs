{{#> layouts/asset.hbs activeTab="download"}}
<section class="card paper max-w-xl mh-auto mb-xl">
  <p class="subtitle">Verified download</p>
  <h1>{{asset.name}} {{version.name}}</h1>
  <p>The file is checked locally against the published SHA-256 hash before it is saved.</p>
  <div class="checksum-row">
    <span>SHA-256</span>
    <code>{{version.sha256}}</code>
  </div>
  <button id="downloadBtn" class="btn primary" data-url="{{version.download_url}}"
    data-sha="{{version.sha256}}">Download and verify</button>
  <div id="progressContainer" class="download-progress" hidden>
    <p id="status" role="status" aria-live="polite">Preparing download…</p>
    <progress id="progress" value="0" max="100"></progress>
  </div>
  <noscript>
    <p>Please enable JavaScript to download the asset.</p>
    <p>Alternatively, you can download it directly from <a href="{{version.download_url}}">this link</a>.</p>
    <p>Make sure to verify the SHA-256 checksum <code>{{version.sha256}}</code> after downloading.</p>
  </noscript>
  <div>{{{md version.changes}}}</div>
</section>

<script src="download.js"></script>
{{/layouts/asset.hbs}}
