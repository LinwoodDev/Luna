{{#> layouts/main.hbs title="Authors" active_page="authors"}}
<div class="container">
    <section class="long-section">
        <h1>Authors</h1>
        <p>{{total_count}} registered {{#if (eq total_count 1)}}author{{else}}authors{{/if}}.</p>
    </section>
    <section class="section mt-md">
        <ul class="col gap-sm p-none">
            {{#each authors}}
            {{> components/item.hbs href=(concat this.name) title=(display this) description=this.description }}
            {{else}}
            <li class="col justify-center align-center gap-sm">
                <p class="text">No authors found.</p>
            </li>
            {{/each}}
        </ul>
        <nav class="row wrap align-center justify-center gap-md mv-lg" aria-label="Authors pagination">
            {{#if previous_page_path}}
            <a class="btn secondary" href="{{previous_page_path}}">Previous</a>
            {{/if}}
            <span class="text">Page {{current_page}} of {{last_page}}{{#if page_start}} · {{page_start}}–{{page_end}} of {{total_count}}{{/if}}</span>
            {{#if next_page_path}}
            <a class="btn secondary" href="{{next_page_path}}">Next</a>
            {{/if}}
        </nav>
    </section>
</div>
{{/layouts/main.hbs}}
