{{#> layouts/main.hbs title="Search" active_page="search"}}
<div class="container mt-md">
    <section class="long-section">
        <h1>Search</h1>
        <p>Filter {{asset_count}} {{#if (eq asset_count 1)}}asset{{else}}assets{{/if}} and {{author_count}} {{#if (eq author_count 1)}}author{{else}}authors{{/if}} instantly.</p>
    </section>
    <form class="col gap-lg mb-xl" method="get" action="search.html" role="search">
        <section class="card paper col gap-md">
            <div class="row gap-xs align-stretch">
                <input aria-label="Search query" type="search" id="search-input" class="flex m-none form-control" name="q" placeholder="Search assets and authors…" autofocus>
                <button type="submit" class="btn primary">Search</button>
            </div>

            <div class="row wrap gap-md align-center">
                <strong>Show</strong>
                <div class="form-group">
                    <input type="checkbox" name="authors" id="search-authors" checked>
                    <label for="search-authors" class="form-label">Authors</label>
                </div>
                <div class="form-group">
                    <input type="checkbox" name="assets" id="search-assets" checked>
                    <label for="search-assets" class="form-label">Assets</label>
                </div>
            </div>

            <details>
                <summary class="bold">Category filters</summary>
                <div id="search-filters" hidden class="mt-sm">
                    <div id="search-categories" class="col gap-xs"></div>
                </div>
            </details>
        </section>

        <noscript>
            <p>JavaScript is required to use the search functionality.</p>
        </noscript>
            
        <section id="search-results" hidden aria-live="polite">
            <div class="row align-center justify-between">
                <h2>Results</h2>
                <p id="search-status">Loading...</p>
            </div>
            <ul id="search-list" class="col gap-sm p-none">
                {{> components/item.hbs id="search-item-template" href="#" title="" description="Result description" style="display:none" }}
            </ul>
        </section>
            
        <section id="search-empty" hidden class="card paper text-center">
            <h3>Start searching</h3>
            <p>Enter a search term or select filters to find assets and authors.</p>
        </section>
    </form>
</div>
<script src="search.js"></script>
{{/layouts/main.hbs}}
