{{#> layouts/main.hbs title=(concat "Category: " category.name) active_page="categories"}}
<div class="container">
    <section class="long-section">
        <h1>{{category.name}}</h1>
        <p>{{total_count}} matching {{#if (eq total_count 1)}}asset{{else}}assets{{/if}}.</p>
    </section>
    <section class="section mt-md">
        <ul class="col gap-sm p-none">
            {{#each assets}}
            {{> components/item.hbs href=(concat this.author "/" this.name) title=this.name description=this.summary }}
            {{else}}
            <li class="col justify-center align-center gap-sm">
                <p class="text">No assets found.</p>
            </li>
            {{/each}}
        </ul>
        <nav class="row wrap align-center justify-center gap-md mv-lg" aria-label="Category pagination">
            {{#if previous_page_path}}
            <a class="btn secondary" href="{{previous_page_path}}">Previous</a>
            {{/if}}
            <span class="text">Page {{current_page}} of {{last_page}}{{#if page_start}} · {{page_start}}–{{page_end}} of {{total_count}}{{/if}}</span>
            {{#if next_page_path}}
            <a class="btn secondary" href="{{next_page_path}}">Next</a>
            {{/if}}
        </nav>
    </section>
</div>
{{/layouts/main.hbs}}
