<section class="card paper row wrap align-center justify-between gap-lg mv-xl">
  <div class="col gap-xs flex">
    <h2>Search the registry</h2>
    <p>Search assets, authors, and categories from one place.</p>
  </div>
  <form class="col gap-sm flex min-w-md" method="get" action="search.html" role="search">
    <div class="row gap-xs align-stretch">
      <input aria-label="Search query" type="search" class="flex m-none form-control" name="q" placeholder="Search assets and authors…">
      <button type="submit" class="btn primary">Search</button>
    </div>

    <div class="row gap-md align-center wrap">
      <div class="form-group">
        <input type="checkbox" name="authors" id="search-authors" checked>
        <label for="search-authors" class="form-label">Authors</label>
      </div>
      <div class="form-group">
        <input type="checkbox" name="assets" id="search-assets" checked>
        <label for="search-assets" class="form-label">Assets</label>
      </div>
    </div>

  </form>
</section>
